# Offline test environment — uses vendored dependencies, no network needed
# during Go build. Use this if you have proxy/VPN/SSL certificate issues.
#
# Build: docker build -f Dockerfile.test.offline -t fpm-test .
# Run:   docker run -it --rm fpm-test bash
#
# Prerequisites: run `go mod vendor` locally before building.

FROM golang:latest AS builder

WORKDIR /fpm
COPY . .
RUN CGO_ENABLED=0 go build -mod=vendor -ldflags "-s -w" -o /fpm-bin ./cmd/fpm

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.local/share/fpm/bin:/root/.local/bin:/root/.cargo/bin:/usr/local/bin:${PATH}"

# System dependencies
RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-venv \
    ca-certificates curl wget git build-essential \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-built fpm binary
COPY --from=builder /fpm-bin /usr/local/bin/fpm

# Install uv (for coexistence testing)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh || true

# Install conda/miniconda (for coexistence testing)
RUN wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh \
    && bash /tmp/miniconda.sh -b -p /opt/conda \
    && rm /tmp/miniconda.sh || true
ENV PATH="/opt/conda/bin:${PATH}"

WORKDIR /workspace
RUN fpm version
CMD ["/bin/bash"]
