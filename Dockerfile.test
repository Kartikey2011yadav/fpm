FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.local/share/fpm/bin:/root/.local/bin:/usr/local/go/bin:${PATH}"

# System dependencies
RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-venv \
    curl wget git build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Go (for building fpm from source)
RUN curl -fsSL https://go.dev/dl/go1.22.4.linux-amd64.tar.gz | tar -C /usr/local -xzf -

# Install uv (for coexistence testing)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Install conda/miniconda (for coexistence testing)
RUN wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh \
    && bash /tmp/miniconda.sh -b -p /opt/conda \
    && rm /tmp/miniconda.sh
ENV PATH="/opt/conda/bin:${PATH}"

# Copy fpm source and build
WORKDIR /fpm
COPY . .
RUN go build -o /usr/local/bin/fpm ./cmd/fpm

# Create test workspace
WORKDIR /workspace

# Verify installations
RUN python3 --version && pip3 --version && fpm version && uv --version && conda --version

CMD ["/bin/bash"]
