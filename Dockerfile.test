FROM golang:1.22-bookworm AS builder

WORKDIR /fpm
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /fpm-bin ./cmd/fpm

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.local/share/fpm/bin:/root/.local/bin:/usr/local/bin:${PATH}"

# System dependencies + CA certificates (fixes SSL issues)
RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-venv \
    ca-certificates curl wget git build-essential \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-built fpm binary from builder stage
COPY --from=builder /fpm-bin /usr/local/bin/fpm

# Install uv (for coexistence testing)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh || true

# Install conda/miniconda (for coexistence testing)
RUN wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh \
    && bash /tmp/miniconda.sh -b -p /opt/conda \
    && rm /tmp/miniconda.sh
ENV PATH="/opt/conda/bin:${PATH}"

# Create test workspace
WORKDIR /workspace

# Verify installations
RUN python3 --version && pip3 --version && fpm version

CMD ["/bin/bash"]
